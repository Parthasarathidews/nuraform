# Supabase Configuration
# Get these values from: https://app.supabase.com/project/_/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon (Public) Key
# This key is safe to use in the browser and is required for authentication
# It should start with "eyJ" and be a long JWT token
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ IMPORTANT:
# - Use the "anon" key (also called "public" key), NOT the "service_role" key
# - The anon key is safe to expose in client-side code
# - Never commit the service_role key to version control
# - Get your keys from: Supabase Dashboard → Settings → API
